configuration {
    show-icons: true;
}

* {
    bg-glass: rgba(15, 17, 26, 0.75);
    card-bg: rgba(255, 255, 255, 0.05);
    card-hover: rgba(137, 180, 250, 0.2);
    border-col: rgba(255, 255, 255, 0.12);
    accent: #89b4fa;
    text-color: #ffffff;
    
    background-color: transparent;
    font: "JetBrainsMono Nerd Font 10";
}

window {
    width: 620px;
    height: 580px;
    background-color: @bg-glass;
    border: 1px;
    border-color: @border-col;
    border-radius: 24px;
    padding: 24px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 18px;
}

inputbar {
    background-color: @card-bg;
    border: 1px;
    border-color: @border-col;
    border-radius: 14px;
    padding: 12px 18px;
    children: [ prompt, entry ];
    spacing: 12px;
}

prompt {
    text-color: @accent;
    str: "󰎈";
}

entry {
    placeholder: "Media Controls / Track Search...";
    placeholder-color: rgba(255, 255, 255, 0.35);
    text-color: @text-color;
}

listview {
    columns: 1;
    lines: 9;
    spacing: 8px;
    cycle: true;
    dynamic: true;
}

element {
    padding: 10px 16px;
    background-color: @card-bg;
    border: 1px;
    border-color: rgba(255, 255, 255, 0.02);
    border-radius: 12px;
    children: [ element-text ];
}

element selected {
    background-color: @card-hover;
    border-color: @accent;
}

element-text {
    vertical-align: 0.5;
    text-color: @text-color;
}
