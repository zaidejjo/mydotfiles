{
  "Main entry point": {
    "prefix": "py-main",
    "description": "Main entry point template",
    "body": [
      "def main() -> None:",
      "    ${1:...}",
      "",
      "",
      "if __name__ == '__main__':",
      "    main()",
      ""
    ]
  },
  "Create a function": {
    "prefix": "py-def",
    "description": "Function template",
    "body": [
      "def ${1:new_function}($2) -> ${3:None}:",
      "    ${4:raise NotImplementedError('$1() was not implemented.')}"
    ]
  },
  "Quick debug": {
    "prefix": "py-debug",
    "description": "Quick debug",
    "body": ["print(f'${1:name} = {${2:var}}')", "$0"]
  },
  "Quick try/except": {
    "prefix": "py-try",
    "description": "Quick try/except block template",
    "body": [
      "try:",
      "    ${1:...}",
      "except Exception as e:",
      "    print(f'{type(e).__name__}: {e}')",
      "$0"
    ]
  },
  "Django URL Pattern": {
    "prefix": "urlpt",
    "description": "Create a Django URL pattern with example",
    "body": [
      "from django.urls import path",
      "from . import views",
      "",
      "urlpatterns = [",
      "    path('${1:url}/', views.${2}, name='${3:func_name}'),",
      "]",
      "$0"
    ]
  },
  "Django View Function": {
    "prefix": "viewfn",
    "description": "Create a Django view function",
    "body": [
      "from django.shortcuts import render, get_object_or_404",
      "",
      "def ${1:view_name}(request${2:, pk}):",
      "    ${3:context = {}}",
      "    return render(request, '${4:template_name}.html', context)",
      "$0"
    ]
  },
  "Django Model": {
    "prefix": "model",
    "description": "Create a Django model",
    "body": [
      "from django.db import models",
      "",
      "class ${1:ModelName}(models.Model):",
      "    ${2:field_name} = models.${3:CharField}(max_length=${4:100})",
      "",
      "    def __str__(self):",
      "        return self.${5:field_name}",
      "$0"
    ]
  },
  "Django Form": {
    "prefix": "form",
    "description": "Create a Django form",
    "body": [
      "from django import forms",
      "from .models import ${1:ModelName}",
      "",
      "class ${2:FormName}(forms.ModelForm):",
      "    class Meta:",
      "        model = ${1:ModelName}",
      "        fields = ['${3:field1}', '${4:field2}']",
      "$0"
    ]
  },
  "Django Admin": {
    "prefix": "adminreg",
    "description": "Register model in Django admin",
    "body": [
      "from django.contrib import admin",
      "from .models import ${1:ModelName}",
      "",
      "admin.site.register(${1:ModelName})",
      "$0"
    ]
  },
  "Django Class-Based View": {
    "prefix": "cbv",
    "description": "Create a basic class-based view",
    "body": [
      "from django.views import View",
      "from django.shortcuts import render",
      "",
      "class ${1:MyView}(View):",
      "    def get(self, request, *args, **kwargs):",
      "        ${2:context = {}}",
      "        return render(request, '${3:template_name}.html', context)",
      "$0"
    ]
  }
}
